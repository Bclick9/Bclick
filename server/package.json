{
  "name": "@bclick/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate:up": "node-pg-migrate up --migrations-dir ./migrations --database-url-var DATABASE_URL",
    "catalog:migrate:bigbang:sandbox": "node --env-file=../.env --import=tsx src/bigbang/migrate-sandbox-cli.ts",
    "admin:bootstrap": "tsx src/identity/bootstrap-admin.ts",
    "catalog:sync:bigbang:sandbox": "node --env-file=../.env --import=tsx src/bigbang/sync-cli.ts"
  },
  "dependencies": {
    "@bclick/config": "workspace:*",
    "argon2": "^0.41.1",
    "fastify": "^5.12.7",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.5.1",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
