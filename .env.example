# Local development only. Never use these example values on a shared/staging/production system.
POSTGRES_USER=bclick_dev
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_DB=bclick
POSTGRES_PORT=5432
API_PORT=3000

# Optional local BigBang catalogue sandbox key; never put a live key here.
BIGBANG_SANDBOX_API_KEY=

# Identity is opt-in and local ONLY while Q-011 is open. These secret values are intentionally blank.
BCLICK_IDENTITY_ENABLED=false
# Staging-only MFA break-glass command; code refuses NODE_ENV=production regardless of this flag.
BCLICK_ADMIN_MFA_BREAK_GLASS_ENABLED=false
BCLICK_SESSION_HASH_KEY=
BCLICK_CSRF_SIGNING_KEY=
BCLICK_TOTP_ENCRYPTION_KEY=
# The local bootstrap adds exact private-LAN IPv4 origins for phone testing; never use wildcards.
BCLICK_PLAYER_ALLOWED_ORIGINS=http://localhost:5173
BCLICK_ADMIN_ALLOWED_ORIGINS=http://localhost:5174
BCLICK_LOCAL_MAIL_SINK_PATH=.local-mail-sink.jsonl
BCLICK_TERMS_VERSION=
BCLICK_AGE_POLICY_VERSION=
# One-time local bootstrap: supply these through your shell, never commit real credentials.
IDENTITY_BOOTSTRAP_EMAIL=
IDENTITY_BOOTSTRAP_DISPLAY_NAME=
IDENTITY_BOOTSTRAP_PASSWORD=
