{
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "build": "pnpm --filter frontend build",
    "preview": "pnpm --filter frontend preview",
    "admin:dev": "pnpm --filter backend dev",
    "admin:build": "pnpm --filter backend build",
    "api:dev": "pnpm --filter @bclick/config build && pnpm --filter @bclick/server dev",
    "api:build": "pnpm --filter @bclick/config build && pnpm --filter @bclick/server build",
    "api:test": "pnpm --filter @bclick/config test && pnpm --filter @bclick/money test && pnpm --filter @bclick/server test",
    "api:typecheck": "pnpm --filter @bclick/config build && pnpm --filter @bclick/config typecheck && pnpm --filter @bclick/money typecheck && pnpm --filter @bclick/api-client typecheck && pnpm --filter @bclick/server typecheck",
    "api:lint": "redocly lint docs/planning/openapi.yaml && redocly lint docs/planning/openapi-aggregator-callbacks.yaml",
    "api:client:generate": "pnpm --filter @bclick/api-client generate",
    "api:client:typecheck": "pnpm --filter @bclick/api-client typecheck",
    "frontend:test": "tsx --test frontend/test/*.test.ts",
    "admin:test": "tsx --test backend/test/*.test.ts",
    "api:admin:bootstrap": "pnpm --filter @bclick/config build && pnpm --filter @bclick/server admin:bootstrap",
    "api:admin:bootstrap-local-default": "pnpm --filter @bclick/config build && pnpm --filter @bclick/server admin:bootstrap-local-default"
  },
  "devDependencies": {
    "@redocly/cli": "2.64.1",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
